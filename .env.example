# Reference only: export variables in the shell; .env is not automatically loaded.
APP_ENV=development
# SQLite is the only implemented backend; other values fail validation.
DB_BACKEND=sqlite
DB_NAME=produtos.db
SQLITE_TIMEOUT=5
API_DOCS_ENABLED=true
# Backend HTTP port used by container platforms such as Render.
PORT=8000
# Comma-separated frontend origins allowed to call the API from browsers.
# Use your Vercel URL in production, for example:
# CORS_ALLOWED_ORIGINS=https://product-management-system.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
